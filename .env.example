# Keys for whatever endpoints in models.yaml you enable. Leave blank = skipped.
DEEPSEEK_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
# local ollama/lmstudio/vibeproxy need no key
SIE_API_KEY=

# --- closed-loop ops (all optional; missing creds -> sim outbox/dry-run) ---
# paging bus — severity routes in indictment/alerts.py
INDICT_ALERT_WEBHOOK=            # slack-style webhook {"text": ...}
TWILIO_ACCOUNT_SID=           # sms + voice paging (critical/high)
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                  # e.g. +15551234567
TWILIO_TO=                    # your verified number on trial accounts
INDICT_SMTP_HOST=                # email channel, e.g. smtp.gmail.com:587
INDICT_SMTP_USER=
INDICT_SMTP_PASS=
INDICT_EMAIL_TO=
# autonomous issue filing — our repos only, never scan targets
GITHUB_TOKEN=                 # fine-grained PAT, issues:write
INDICT_ISSUE_REPO=               # owner/name e.g. you/vulnapp
# fix loop — which agent backend patches verified findings
INDICT_FIXER=                    # codex | devin-acp | command (INDICT_FIX_CMD)
INDICT_FIX_CMD=                  # shell cmd run in the worktree, INDICT_TASK=task.md
# INDICT_AUTO_ISSUE=1 / INDICT_FIX_AUTO=1 make the watch daemon fire them on new
# verified findings — default off: demo-triggered, not autonomous surprise.
