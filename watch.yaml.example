# watch registry — repos the daemon rescans on every new commit.
# Watch scans run the deterministic sweep only (no LLM stages) — run LLM
# hunts manually via ./indict <target>; alerts fire on new findings either way.
# Start with: ./indict --watch   (single cycle for testing: ./indict --watch-once)
- url: https://github.com/softdevteam/snare
  # models: [sie]          # optional: restrict scan models
  # budget: 45             # optional: hunt-budget minutes
- url: /absolute/local/path/to/repo
