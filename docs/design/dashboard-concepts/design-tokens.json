  "spacing": {
    "$type": "dimension",
    "micro": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "small": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "compact": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "standard": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "roomy": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "sidebar": {
      "$value": {
        "value": 200,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 36,
        "unit": "px"
      }
    },
    "row": {
      "$value": {
        "value": 42,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
